{
  "name": "@vcmap/xplan",
  "version": "2.0.0",
  "description": "Plugin for the VC Map which allows to query B-Plans from a XPlanung back end and visualize them in 2D as well as in 3D.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prepublishOnly": "vcmplugin build",
    "build": "vcmplugin build",
    "bundle": "vcmplugin bundle",
    "start": "vcmplugin serve",
    "preview": "vcmplugin preview",
    "buildStagingApp": "vcmplugin buildStagingApp",
    "lint:js": "eslint . --ext .vue,.js,.cjs,.mjs,.ts,.cts,.mts",
    "lint:prettier": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:prettier",
    "format": "prettier --write --list-different . && npm run lint:js -- --fix",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "type-check": "vue-tsc --noEmit",
    "ensure-types": "vcmplugin ensure-types"
  },
  "contributors": [
    "Ben Kuster <bkuster@vc.systems>",
    "Tobias Krauth <tkrauth@vc.systems>"
  ],
  "license": "MIT",
  "keywords": [
    "vcmap",
    "plugin"
  ],
  "files": [
    "src/",
    "dist/",
    "plugin-assets/",
    "LICENSE.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "dist/index.js",
    "./dist": "./dist/index.js"
  },
  "repository": {
    "url": "https://gitlab.virtualcitysystems.de/vcsuite/npm/vcmap/xplan.git"
  },
  "eslintIgnore": [
    "node_modules",
    "dist",
    "plugin-assets"
  ],
  "prettier": "@vcsuite/eslint-config/prettier.js",
  "peerDependencies": {
    "@vcmap-cesium/engine": "^11.0.5",
    "@vcmap/core": "^6.3.5",
    "@vcmap/ui": "^6.3.6",
    "ol": "^10.9.0",
    "vue": "~3.4.38",
    "vuetify": "~3.7.14"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@vcmap/plugin-cli": "^4.2.0",
    "@vcsuite/eslint-config": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "jest-canvas-mock": "^2.5.2",
    "jsdom": "^26.1.0",
    "nock": "^14.0.10",
    "resize-observer-polyfill": "^1.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "vue-tsc": "^2.2.12"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "@zip.js/zip.js": "2.7.73"
  },
  "mapVersion": "^6.3",
  "dependencies": {
    "@turf/area": "^7.2.0",
    "@turf/intersect": "^7.2.0",
    "@vcsuite/check": "^3.1.0",
    "@vcsuite/logger": "^1.0.1",
    "fast-deep-equal": "^3.1.3"
  }
}
